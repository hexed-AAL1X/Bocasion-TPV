# --- App (Vite / Electron) ---
# Preferido: consulta DNI (8) / RUC (11) en https://consulta.rucpe.com/
# Obtén clave gratis: https://consulta.rucpe.com/api
VITE_RUCPE_API_KEY=

# Proxy remoto opcional (cPanel). Si no hay VITE_RUCPE_API_KEY, se usa este.
# VITE_API_BASE_URL=https://bocasion.com/dni-api

# --- API local (npm run dev:all) ---
# Con RUCPE_API_KEY, DNI y RUC van a consulta.rucpe.com
RUCPE_API_KEY=
# Fallback legacy (si no usas rucpe):
# DNI_PROVIDER=eldni
# RUC_PROVIDER=apisperu
# APISPERU_TOKEN=
API_PORT=3001
# CORS_ORIGINS=http://localhost:5173,https://tu-dominio.com

