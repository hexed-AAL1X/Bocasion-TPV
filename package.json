{
  "name": "bocasoft",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/hexed-AAL1X/Bocasion-TPV.git"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n api,vite -c yellow,cyan \"npm run dev:api\" \"npm run dev\"",
    "dev:fresh": "rm -rf node_modules/.vite dist-electron && npm run dev:all",
    "build:api": "node server/build.mjs",
    "pack:api": "npm run build:api && mkdir -p release && npm pack --prefix server --pack-destination=release",
    "pack:cpanel": "bash scripts/pack-cpanel.sh",
    "start:api": "npm run start --prefix server",
    "catalog:gen": "python3 scripts/generate-product-catalog.py",
    "gen:boot-theme": "tsx scripts/gen-boot-theme.ts",
    "predev": "npm run gen:boot-theme",
    "build": "npm run gen:boot-theme && tsc && vite build",
    "build:desktop": "BOCASOFT_INSTALLER=1 node scripts/prepare-config-env.cjs && npm run build && electron-builder --linux AppImage && cp -f scripts/run-intranet-ventas.sh release/Intranet-Ventas.sh && chmod +x release/Intranet-Ventas.sh release/*.AppImage && (cp -f release/*.AppImage release/Intranet-Ventas.AppImage 2>/dev/null || true)",
    "build:win": "BOCASOFT_INSTALLER=1 node scripts/prepare-config-env.cjs && npm run build && electron-builder --win",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "build:tauri:linux": "tauri build --bundles deb",
    "build:tauri:win": "tauri build --bundles nsis",
    "pack:linux": "npm run build:desktop",
    "pack:win": "npm run build:win",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.bocasion.bocasoft",
    "productName": "Intranet Ventas",
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/afterPack.cjs",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "package.json",
      "!**/node_modules/**/{CHANGELOG.md,README.md,README,readme.md,LICENSE,LICENSE.txt,*.map,*.d.ts,*.ts}",
      "!**/node_modules/**/dist/{browser,esm,es}/**",
      "!**/node_modules/**/{test,tests,docs,examples,coverage,__tests__}/**"
    ],
    "extraResources": [
      {
        "from": "build/config.env",
        "to": "config.env"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "public/images/apicon.png",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/apicon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "hexed-AAL1X",
      "repo": "Bocasion-TPV",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Intranet Ventas",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "perMachine": false,
      "allowElevation": true
    }
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/poppins": "^5.2.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^26.15.3",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
